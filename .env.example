# ============================================
# EmailJS Configuration
# ============================================
# Crea tu cuenta gratis en https://www.emailjs.com/
# 1. Conecta un servicio de email (Gmail, Outlook, etc.)
# 2. Crea una plantilla con las variables:
#    {{from_name}}, {{from_email}}, {{phone}}, {{message}}, {{to_email}}, {{subject}}
# 3. Copia los IDs aquí
#
# Alternativa: también puedes configurarlos en
# src/config/site.config.js -> contact.emailjs

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=